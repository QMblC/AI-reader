# Copy to .env. Spring loads it locally; keep the actual key out of Git.
YANDEX_ENABLED=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
ILLUSTRATION_ENABLED=true
ILLUSTRATION_MODEL=aliceai-image-art-3.0
ILLUSTRATION_SCENE_MODEL=yandexgpt-lite
DATABASE_URL=jdbc:postgresql://localhost:5432/aireader
DATABASE_USERNAME=aireader
DATABASE_PASSWORD=aireader
IMAGE_STORAGE_DIRECTORY=./data/images
CACHE_TTL=48h
CACHE_CLEANUP_INTERVAL=60s
RATE_LIMIT_REQUESTS_PER_MINUTE=6
# Firebase project number and comma-separated App IDs of allowed iOS/Android apps.
APP_CHECK_PROJECT_NUMBER=
APP_CHECK_ALLOWED_APP_IDS=
GUEST_ACCESS_TTL=30m
GUEST_SESSION_TTL=30d
GUEST_SESSION_CREATIONS_PER_MINUTE=30
GUEST_SESSION_REFRESHES_PER_MINUTE=10
GUEST_ANALYSES_PER_DAY=20
GUEST_ILLUSTRATIONS_PER_DAY=3
TOTAL_ANALYSES_PER_DAY=200
TOTAL_ILLUSTRATIONS_PER_DAY=30
