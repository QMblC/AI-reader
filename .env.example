# Copy to .env. Spring loads it locally; keep the actual key out of Git.
YANDEX_ENABLED=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
ILLUSTRATION_ENABLED=true
ILLUSTRATION_MODEL=aliceai-image-art-3.0
ILLUSTRATION_SCENE_MODEL=yandexgpt-lite
DATABASE_URL=jdbc:postgresql://localhost:5432/aireader
DATABASE_USERNAME=aireader
DATABASE_PASSWORD=aireader
IMAGE_STORAGE_DIRECTORY=./data/images
CACHE_TTL=48h
CACHE_CLEANUP_INTERVAL=60s
RATE_LIMIT_REQUESTS_PER_MINUTE=6
